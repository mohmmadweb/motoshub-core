# ── Django ─────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://motonextapi.shub.ir,https://api.shub.ir

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgres://motoshub:motoshub@localhost:5432/motoshub_core

# ── Redis (cache + Celery broker + Channels layer) ─────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ── Unified JWT (HS256) ────────────────────────────────────────────────────
# OW_PASSWORD_PEPPER is the SHARED secret with the PHP/Oxwall backend so a
# token issued by either side validates on the other (gateway cross-compat).
OW_PASSWORD_PEPPER=shared-secret-must-match-php-backend
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ── CORS (Next frontend origins) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://motonextfront.shub.ir

# ── Media / storage ────────────────────────────────────────────────────────
MEDIA_URL=/media/

# ── Assistant LLM (optional; configure EITHER, else a matcher answers) ────────
# OpenAI-compatible provider. Two common choices:
#
#   • OpenRouter (free models to start; paid later = just change OPENAI_MODEL):
#       OPENAI_BASE_URL=https://openrouter.ai/api/v1
#       OPENAI_API_KEY=sk-or-...                       # from openrouter.ai/keys
#       OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free   # a ":free" model id
#       OPENAI_HTTP_REFERER=https://motonextfront.shub.ir     # optional (rankings)
#       OPENAI_APP_TITLE=Motoshub                             # optional
#
#   • Local Ollama (free, offline, no key):
#       OPENAI_BASE_URL=http://localhost:11434/v1
#       OPENAI_MODEL=qwen2.5
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_HTTP_REFERER=
OPENAI_APP_TITLE=
# Alternative — Anthropic (Claude):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
