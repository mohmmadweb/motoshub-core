# Ready-made environment for prod.shub.ir
#   cp infra/.env.prod.shub.ir.example infra/.env   →   fill the secrets   →   deploy
#
#   docker compose -f infra/docker-compose.yml -f infra/tls/compose.tls.yml --env-file infra/.env up -d

DOMAIN=prod.shub.ir

# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Must MATCH the PHP backend so JWTs interoperate.
OW_PASSWORD_PEPPER=
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7

# Email notifications (mentions + direct messages). Leave EMAIL_HOST empty to
# print mail to the console instead of sending it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=موتوشاب <no-reply@shub.ir>
