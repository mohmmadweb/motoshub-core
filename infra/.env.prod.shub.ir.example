# Ready-made environment for prod.shub.ir
#   cp infra/.env.prod.shub.ir.example infra/.env   →   fill the secrets   →   deploy
#
#   docker compose -f infra/docker-compose.yml -f infra/prod/compose.prod.yml \
#     --env-file infra/.env up -d --build
#
# See infra/prod/README.md for DNS and TLS.

DOMAIN=prod.shub.ir
# Public IP — also accepted as a Host so the site is reachable before DNS
# propagates. Remove it once the domain resolves if you want to be strict.
SERVER_IP=104.194.140.222

# Host ports. Deliberately NOT 80/443: this stack shares the machine with other
# services and must not compete for the standard ports.
HTTP_PORT=9080
HTTPS_PORT=9443

# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Must MATCH the PHP backend so JWTs interoperate.
OW_PASSWORD_PEPPER=
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Set to True the moment a TLS certificate is installed. While it is False the
# site is served over plain HTTP: usable, but sessions are not encrypted.
SECURE_SSL_REDIRECT=False

# Backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7

# Email notifications (mentions + direct messages). Leave EMAIL_HOST empty to
# print mail to the console instead of sending it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=موتوشاب <no-reply@shub.ir>
