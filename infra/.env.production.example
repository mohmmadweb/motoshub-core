# Production environment for the Docker stack.
#   cp infra/.env.production.example infra/.env  &&  edit  &&  never commit it.
#
# Generate strong values:
#   SECRET_KEY:         python -c "import secrets;print(secrets.token_urlsafe(64))"
#   OW_PASSWORD_PEPPER: must MATCH the PHP backend (shared JWT signing secret)
#   POSTGRES_PASSWORD:  python -c "import secrets;print(secrets.token_urlsafe(32))"

SECRET_KEY=
OW_PASSWORD_PEPPER=
POSTGRES_PASSWORD=

# The domain the certificate is issued for (used by the TLS overlay).
DOMAIN=

# Backups (infra/backup/README.md)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7

# Assistant LLM — optional. OpenRouter, a local Ollama, or Anthropic.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
